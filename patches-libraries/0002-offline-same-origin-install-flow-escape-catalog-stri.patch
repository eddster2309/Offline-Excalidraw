From 1cbedabfdc2db5b180244ae6b73737a43b5c2a4a Mon Sep 17 00:00:00 2001
From: Claude <claude@accounts.eddster.com>
Date: Wed, 18 Nov 2026 18:22:49 +1100
Subject: [PATCH 2/3] offline: same-origin install flow, escape catalog
 strings, no external links

- libraries are handed to the editor as absolute same-origin URLs
  (<origin>/libraries/libraries/<author>/<file>.excalidrawlib)
- the referrer defaults to the app root and is restricted to this origin
- catalog strings are HTML-escaped (the catalog is publishable offline)
- external author links are shown as text
- the `target` parameter (editor window name) is restricted to [A-Za-z0-9_-]
  (upstream escaped then decoded it: reflected XSS on the app origin)
---
 script.js | 100 ++++++++++++++++++++++++++++++++++--------------------
 1 file changed, 64 insertions(+), 36 deletions(-)

diff --git a/script.js b/script.js
index 7de6b11..8c5540f 100644
--- a/script.js
+++ b/script.js
@@ -113,21 +113,47 @@ const sortBy = {
 };
 
 // -----------------------------------------------------------------------------
-const APP_NAMES = {
-  "Excalidraw+": "https://app.excalidraw.com",
-  Excalidraw: "https://excalidraw.com",
-  Excalideck: "https://app.excalideck.com",
+// Offline build: the site is served from <app origin>/libraries/ and the
+// editor lives at the app origin (one level up). Only same-origin referrers are
+// honoured so the "Add to Excalidraw" link can never navigate off-origin.
+const APP_NAME = "Excalidraw";
+const DEFAULT_REFERRER = new URL("../", location.href).href;
+
+const getReferrer = (searchParams) => {
+  const requested = searchParams.get("referrer");
+  if (requested) {
+    try {
+      const url = new URL(requested, location.href);
+      if (url.origin === location.origin) {
+        return url.href;
+      }
+    } catch (e) {}
+  }
+  return DEFAULT_REFERRER;
 };
 
-let appName = "";
+// libraries.json is user-publishable offline, so never trust its strings as HTML
+const escapeHTML = (str) =>
+  String(str ?? "").replace(
+    /[&<>"']/g,
+    (char) =>
+      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
+        char
+      ],
+  );
 
-const getAppName = (referrer) => {
-  return (appName =
-    appName ||
-    Object.entries(APP_NAMES).find(([appName, domain]) => {
-      return referrer.includes(domain);
-    })?.[0] ||
-    "Excalidraw");
+// only same-origin author links stay clickable (an air-gapped browser cannot
+// reach external sites); anything else is shown as plain text
+const renderAuthor = (author) => {
+  const label = `@${escapeHTML(author.name)}`;
+  try {
+    const url = new URL(author.url, location.href);
+    if (author.url && url.origin === location.origin) {
+      return `<a href="${escapeHTML(url.href)}" target="_blank">${label}</a> `;
+    }
+  } catch (e) {}
+  const title = author.url ? ` title="${escapeHTML(author.url)}"` : "";
+  return `<span class="author"${title}>${label}</span> `;
 };
 // -----------------------------------------------------------------------------
 
