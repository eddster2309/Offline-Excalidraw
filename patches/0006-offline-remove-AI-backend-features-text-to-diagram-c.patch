diff --git a/excalidraw-app/components/MermaidCache.tsx b/excalidraw-app/components/MermaidCache.tsx
new file mode 100644
index 000000000..d3e1e38cd
--- /dev/null
+++ b/excalidraw-app/components/MermaidCache.tsx
@@ -0,0 +1,20 @@
+import { useOnExcalidrawStateChange } from "@excalidraw/excalidraw";
+
+import { cacheMermaidChunks } from "../data/cacheMermaidChunks";
+
+/**
+ * Caches the (lazy-loaded) mermaid chunks once the TTD dialog is opened,
+ * so that Mermaid to Excalidraw keeps working offline.
+ */
+export const MermaidCache = () => {
+  useOnExcalidrawStateChange(
+    (appState) => appState.openDialog?.name === "ttd",
+    (isTTDDialogOpen) => {
+      if (isTTDDialogOpen) {
+        cacheMermaidChunks();
+      }
+    },
+  );
+
+  return null;
+};
