+import { useEffect } from "react";
+
+import { useAtomValue } from "../app-jotai";
+import { isCollaboratingAtom } from "../collab/Collab";
+import { runtimeConfigAtom } from "../data/runtimeConfig";
+
+import "./EnvironmentBanner.scss";
+
+/**
+ * full-width strip at the very top, e.g. "QA" / "PROD" (text only). In mode
+ * "sending" it is only shown while a live collaboration session is active
+ * (the scene leaves the browser); mode "always" shows it permanently.
+ */
+export const EnvironmentBanner = () => {
+  const { banner } = useAtomValue(runtimeConfigAtom);
+  const isCollaborating = useAtomValue(isCollaboratingAtom);
+  const visible = !!banner && (banner.mode === "always" || isCollaborating);
+
+  // The editor re-measures itself through a ResizeObserver; additionally nudge
+  // it with a window resize so it never keeps a stale size/offset when the
+  // banner appears or disappears.
+  useEffect(() => {
+    const frame = requestAnimationFrame(() => {
+      window.dispatchEvent(new Event("resize"));
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [visible]);
+
+  if (!banner || !visible) {
+    return null;
+  }
+  return (
+    <div
+      className="environment-banner"
+      role="status"
+      data-testid="environment-banner"
+      style={{ backgroundColor: banner.color, color: banner.textColor }}
+    >
+      {banner.text}
+    </div>
+  );
+};
