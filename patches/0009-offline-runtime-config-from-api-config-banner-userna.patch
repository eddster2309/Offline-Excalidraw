@@ -0,0 +1,87 @@
+import {
+  DEFAULT_RUNTIME_CONFIG,
+  parseRuntimeConfig,
+} from "../data/runtimeConfig";
+
+describe("parseRuntimeConfig", () => {
+  it("falls back to defaults on garbage", () => {
+    expect(parseRuntimeConfig(null)).toEqual(DEFAULT_RUNTIME_CONFIG);
+    expect(parseRuntimeConfig("x")).toEqual(DEFAULT_RUNTIME_CONFIG);
+    expect(parseRuntimeConfig({})).toEqual(DEFAULT_RUNTIME_CONFIG);
+  });
+
+  it("parses banner, username and persistence", () => {
+    expect(
+      parseRuntimeConfig({
+        banner: { text: "QA", color: "#123456", textColor: "white" },
+        username: " Ada ",
+        usernameLocked: true,
+        persistence: false,
+      }),
+    ).toEqual({
+      banner: {
+        text: "QA",
+        color: "#123456",
+        textColor: "white",
+        mode: "always",
+      },
+      shareNote: null,
+      username: "Ada",
+      usernameLocked: true,
+      persistence: false,
+      collaboration: true,
+    });
+  });
+
+  it("only locks when a username is present", () => {
+    expect(
+      parseRuntimeConfig({ username: null, usernameLocked: true })
+        .usernameLocked,
+    ).toBe(false);
+    expect(
+      parseRuntimeConfig({ username: "a", usernameLocked: false })
+        .usernameLocked,
+    ).toBe(false);
+  });
+});
+
+describe("collaboration toggle", () => {
+  it("is enabled by default and for older servers", () => {
+    expect(DEFAULT_RUNTIME_CONFIG.collaboration).toBe(true);
+    expect(parseRuntimeConfig({}).collaboration).toBe(true);
+    expect(parseRuntimeConfig({ persistence: false }).collaboration).toBe(true);
+    expect(parseRuntimeConfig({ collaboration: "no" }).collaboration).toBe(
+      true,
+    );
+  });
+
+  it("is disabled only by an explicit false", () => {
+    expect(parseRuntimeConfig({ collaboration: false }).collaboration).toBe(
+      false,
+    );
+    expect(parseRuntimeConfig({ collaboration: true }).collaboration).toBe(
+      true,
+    );
+  });
+});
+
+describe("banner mode and share note", () => {
+  it("defaults the mode to always, accepts sending", () => {
+    expect(parseRuntimeConfig({ banner: { text: "QA" } }).banner?.mode).toBe(
+      "always",
+    );
+    expect(
+      parseRuntimeConfig({ banner: { text: "QA", mode: "sending" } }).banner
+        ?.mode,
+    ).toBe("sending");
+    expect(
+      parseRuntimeConfig({ banner: { text: "QA", mode: "x" } }).banner?.mode,
+    ).toBe("always");
+  });
+
+  it("parses the share note", () => {
+    expect(parseRuntimeConfig({}).shareNote).toBeNull();
+    expect(parseRuntimeConfig({ shareNote: "  a\nb " }).shareNote).toBe("a\nb");
+    expect(parseRuntimeConfig({ shareNote: 5 }).shareNote).toBeNull();
+  });
+});
diff --git a/excalidraw-app/tests/shareNoteMarkup.test.ts b/excalidraw-app/tests/shareNoteMarkup.test.ts
new file mode 100644
index 000000000..beb677ef4
--- /dev/null
+++ b/excalidraw-app/tests/shareNoteMarkup.test.ts
@@ -0,0 +1,73 @@
+import { parseShareNote } from "../share/shareNoteMarkup";
+
+describe("parseShareNote", () => {
+  it("plain text and newlines", () => {
+    expect(parseShareNote("a\nb")).toEqual(["a\nb"]);
+    expect(parseShareNote("")).toEqual([]);
+  });
+
+  it("bold", () => {
+    expect(parseShareNote("a **b** c")).toEqual([
+      "a ",
+      { type: "strong", children: ["b"] },
+      " c",
+    ]);
+  });
+
+  it("named and hex colours", () => {
+    expect(parseShareNote("[red]x[/]")).toEqual([
+      { type: "color", color: "red", children: ["x"] },
+    ]);
+    expect(parseShareNote("[#c92a2a]x[/] [#abc]y[/]")).toEqual([
+      { type: "color", color: "#c92a2a", children: ["x"] },
+      " ",
+      { type: "color", color: "#abc", children: ["y"] },
+    ]);
+  });
+
+  it("invalid colours stay literal", () => {
+    for (const bad of [
+      "red;x",
+      "#12",
+      "#12345g",
+      "rgb(0,0,0)",
+      "url(x)",
+      "a",
+    ]) {
+      expect(parseShareNote(`[${bad}]x[/]`)).toEqual([`[${bad}]x[/]`]);
+    }
+  });
+
+  it("nesting both ways", () => {
+    expect(parseShareNote("**[red]x[/]**")).toEqual([
+      {
+        type: "strong",
+        children: [{ type: "color", color: "red", children: ["x"] }],
+      },
+    ]);
+    expect(parseShareNote("[#c92a2a]**x**[/]")).toEqual([
+      {
+        type: "color",
+        color: "#c92a2a",
+        children: [{ type: "strong", children: ["x"] }],
+      },
+    ]);
+  });
+
+  it("unclosed or unmatched markers are literal", () => {
+    expect(parseShareNote("**a")).toEqual(["**a"]);
+    expect(parseShareNote("[red]a")).toEqual(["[red]a"]);
+    expect(parseShareNote("a[/]b")).toEqual(["a[/]b"]);
+    expect(parseShareNote("**a [red]b**")).toEqual(["**a [red]b**"]);
+    expect(parseShareNote("**a **[red]b[/]")).toEqual([
+      { type: "strong", children: ["a "] },
+      { type: "color", color: "red", children: ["b"] },
+    ]);
+  });
+
+  it("HTML is literal", () => {
+    expect(parseShareNote("<b>x</b> <img src=x>")).toEqual([
+      "<b>x</b> <img src=x>",
+    ]);
+  });
+});
