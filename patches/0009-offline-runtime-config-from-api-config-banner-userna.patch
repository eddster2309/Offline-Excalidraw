diff --git a/excalidraw-app/share/shareNoteMarkup.ts b/excalidraw-app/share/shareNoteMarkup.ts
new file mode 100644
index 000000000..1f9b58a61
--- /dev/null
+++ b/excalidraw-app/share/shareNoteMarkup.ts
@@ -0,0 +1,78 @@
+/**
+ * Tiny, safe markup for the share dialog note (SHARE_NOTE). Not HTML:
+ *   **bold**            -> strong
+ *   [red]text[/]        -> coloured (CSS colour name, #rgb or #rrggbb)
+ * Anything unmatched or invalid stays literal text. The result is a tree that
+ * is rendered as React elements (no innerHTML anywhere).
+ */
+export type NoteNode =
+  | string
+  | { type: "strong"; children: NoteNode[] }
+  | { type: "color"; color: string; children: NoteNode[] };
+
+const COLOR = /^(?:[a-zA-Z]{3,30}|#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6})$/;
+const TOKEN = /\*\*|\[\/\]|\[([^[\]\s]+)\]/g;
+
+type Frame = {
+  type: "root" | "strong" | "color";
+  color?: string;
+  raw: string;
+  children: NoteNode[];
+};
+
+const push = (children: NoteNode[], node: NoteNode) => {
+  const last = children[children.length - 1];
+  if (typeof node === "string" && typeof last === "string") {
+    children[children.length - 1] = last + node;
+  } else if (node !== "") {
+    children.push(node);
+  }
+};
+
+export const parseShareNote = (input: string): NoteNode[] => {
+  const root: Frame = { type: "root", raw: "", children: [] };
+  const stack: Frame[] = [root];
+  const top = () => stack[stack.length - 1];
+
+  let index = 0;
+  for (const match of input.matchAll(TOKEN)) {
+    const [token, colour] = match;
+    push(top().children, input.slice(index, match.index));
+    index = match.index! + token.length;
+
+    if (token === "**") {
+      if (top().type === "strong") {
+        const frame = stack.pop()!;
+        push(top().children, { type: "strong", children: frame.children });
+      } else {
+        stack.push({ type: "strong", raw: token, children: [] });
+      }
+    } else if (token === "[/]") {
+      if (top().type === "color") {
+        const frame = stack.pop()!;
+        push(top().children, {
+          type: "color",
+          color: frame.color!,
+          children: frame.children,
+        });
+      } else {
+        push(top().children, token);
+      }
+    } else if (colour && COLOR.test(colour)) {
+      stack.push({ type: "color", color: colour, raw: token, children: [] });
+    } else {
+      push(top().children, token);
+    }
+  }
+  push(top().children, input.slice(index));
+
+  // unclosed markers: render them literally, keep their content
+  while (stack.length > 1) {
+    const frame = stack.pop()!;
+    push(top().children, frame.raw);
+    for (const child of frame.children) {
+      push(top().children, child);
+    }
+  }
+  return root.children;
+};
diff --git a/excalidraw-app/tests/runtimeConfig.test.ts b/excalidraw-app/tests/runtimeConfig.test.ts
new file mode 100644
index 000000000..54e762fe0
