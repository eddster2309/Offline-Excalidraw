diff --git a/excalidraw-app/data/runtimeConfig.ts b/excalidraw-app/data/runtimeConfig.ts
new file mode 100644
index 000000000..3fbcc8193
--- /dev/null
+++ b/excalidraw-app/data/runtimeConfig.ts
@@ -0,0 +1,83 @@
+/**
+ * Runtime configuration served by the offline server at `GET /api/config`
+ * (environment banner, username from a reverse-proxy header, persistence
+ * toggle, collaboration toggle). Fetched once at startup; any failure falls
+ * back to the defaults, so the app also works against an older server.
+ */
+import { atom, appJotaiStore } from "../app-jotai";
+
+export type RuntimeConfig = {
+  banner: {
+    text: string;
+    color: string;
+    textColor: string;
+    /** "sending": only while a live collaboration session is active */
+    mode: "sending" | "always";
+  } | null;
+  /** plain-text note shown in the share dialog */
+  shareNote: string | null;
+  username: string | null;
+  usernameLocked: boolean;
+  persistence: boolean;
+  /** false: no live collaboration (no socket is ever opened) */
+  collaboration: boolean;
+};
+
+export const DEFAULT_RUNTIME_CONFIG: RuntimeConfig = {
+  banner: null,
+  shareNote: null,
+  username: null,
+  usernameLocked: false,
+  persistence: true,
+  collaboration: true,
+};
+
+export const runtimeConfigAtom = atom<RuntimeConfig>(DEFAULT_RUNTIME_CONFIG);
+
+export const getRuntimeConfig = (): RuntimeConfig =>
+  appJotaiStore.get(runtimeConfigAtom);
+
+const str = (value: unknown, max: number): string | null =>
+  typeof value === "string" && value.trim() ? value.trim().slice(0, max) : null;
+
+/** defensive parsing of the server response */
+export const parseRuntimeConfig = (data: any): RuntimeConfig => {
+  const config: RuntimeConfig = { ...DEFAULT_RUNTIME_CONFIG };
+  if (!data || typeof data !== "object") {
+    return config;
+  }
+  const text = str(data.banner?.text, 100);
+  if (text) {
+    config.banner = {
+      text,
+      color: str(data.banner.color, 32) ?? "#8b0000",
+      textColor: str(data.banner.textColor, 32) ?? "#ffffff",
+      mode: data.banner.mode === "sending" ? "sending" : "always",
+    };
+  }
+  config.shareNote =
+    typeof data.shareNote === "string"
+      ? data.shareNote.replace(/\r\n?/g, "\n").trim().slice(0, 500) || null
+      : null;
+  config.username = str(data.username, 64);
+  config.usernameLocked = !!config.username && data.usernameLocked !== false;
+  config.persistence = data.persistence !== false;
+  // missing (older server) means enabled
+  config.collaboration = data.collaboration !== false;
+  return config;
+};
+
+export const loadRuntimeConfig = async (): Promise<RuntimeConfig> => {
+  try {
+    const response = await fetch("/api/config", {
+      cache: "no-store",
+      signal: AbortSignal.timeout(3000),
+    });
+    if (!response.ok) {
+      return DEFAULT_RUNTIME_CONFIG;
+    }
+    return parseRuntimeConfig(await response.json());
+  } catch (error: any) {
+    return DEFAULT_RUNTIME_CONFIG;
+  }
+};
