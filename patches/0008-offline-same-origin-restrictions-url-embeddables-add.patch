From 5a4e5f5ef0c0c849285a6ef05f380ab4ac5136bb Mon Sep 17 00:00:00 2001
From: Claude <claude@accounts.eddster.com>
Date: Wed, 18 Nov 2026 20:56:09 +1100
Subject: [PATCH 8/9] offline: same-origin restrictions (#url=, embeddables,
 #addLibrary) and library catalog

- #url= scenes, embeddables and #addLibrary= install urls must be same
  origin (one shared isSameOriginUrl helper)
- VITE_APP_LIBRARY_URL=/libraries/ and VITE_APP_LIBRARY_BACKEND=/api/libraries
  (relative, served by the offline server; the dev server proxies /libraries
  and /api)
- publish dialog points at the local library catalog and its texts say
  "published" instead of "submitted for review"

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .env.development                              |  6 +++--
 .env.production                               |  6 +++--
 excalidraw-app/App.tsx                        | 18 ++++++++++++-
 .../excalidraw/components/PublishLibrary.tsx  | 25 ++++---------------
 packages/excalidraw/locales/en.json           |  6 ++---
 5 files changed, 33 insertions(+), 28 deletions(-)

diff --git a/.env.development b/.env.development
index 419c215eb..6dab322fc 100644
--- a/.env.development
+++ b/.env.development
@@ -1,7 +1,9 @@
 MODE="development"
 
-VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
-VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries
+# Offline library site + publish backend, served by the offline server on the
+# app origin (relative paths)
+VITE_APP_LIBRARY_URL=/libraries/
+VITE_APP_LIBRARY_BACKEND=/api/libraries
 
 VITE_APP_PLUS_LP=
 VITE_APP_PLUS_APP=
